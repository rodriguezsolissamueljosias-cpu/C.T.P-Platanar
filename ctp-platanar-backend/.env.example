# Cadena de conexión de MongoDB (Atlas en producción, o se ignora si usas `npm run dev:local`)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/ctp_platanar

# Puerto del servidor
PORT=5000

# Secreto para firmar los JWT de sesión de profesores (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-este-valor-por-uno-seguro

# Código opcional para que un profesor inicie sesión con rol admin
ADMIN_ACCESS_CODE=cambia-este-codigo

# Orígenes permitidos por CORS, separados por coma (dominio de Vercel en producción)
FRONTEND_ORIGINS=http://localhost:3000
