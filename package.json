{
  "name": "ctp-platanar",
  "version": "1.0.0",
  "private": true,
  "description": "CTP Platanar - Sistema de Asistencia Web",
  "scripts": {
    "install-deps": "npm install && npm install --prefix ctp-platanar-backend && npm install --prefix ctp-platanar-frontend",
    "backend": "npm start --prefix ctp-platanar-backend",
    "backend:dev": "npm run dev --prefix ctp-platanar-backend",
    "backend:dev-local": "npm run dev:local --prefix ctp-platanar-backend",
    "frontend": "npm start --prefix ctp-platanar-frontend",
    "dev": "concurrently \"npm:backend:dev\" \"npm:frontend\"",
    "dev:local": "concurrently \"npm:backend:dev-local\" \"npm:frontend\"",
    "seed": "npm run seed --prefix ctp-platanar-backend",
    "build": "npm run build --prefix ctp-platanar-frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
